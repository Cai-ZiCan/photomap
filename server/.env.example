# 服务端口
PORT=8787

# 站点信息
SITE_NAME=摄影地图
SITE_DESC=发现身边的摄影观赏点位

# 会话签名密钥：留空则首次启动自动生成并持久化到数据库
SESSION_SECRET=

# ── AI（OpenAI 兼容接口）──
# 不配置 AI_API_KEY 时，仅「链接导入 / AI 提取」功能不可用，其余功能不受影响
# 默认指向智谱开放平台，可换成任意 OpenAI 兼容服务
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_API_KEY=
AI_TEXT_MODEL=glm-4-flash
AI_VISION_MODEL=glm-4v-plus
