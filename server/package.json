{
  "name": "photomap-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "seed": "node --env-file-if-exists=.env --eval \"import('./src/seed/seed.js').then(m => m.seed(true)).then(() => process.exit(0))\""
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "cheerio": "^1.0.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "multer": "^2.0.1",
    "sharp": "^0.34.1"
  }
}
